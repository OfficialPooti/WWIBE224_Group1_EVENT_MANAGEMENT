@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Registration',
  typeNamePlural: 'Registrations',
  title.value: 'LastName',
  description.value: 'EventTitle'
}

annotate view ZC_REGISTRATIONTPG1 with {

  @UI.facet: [
    { position: 10, targetQualifier: 'RegDetails', label: 'Details', type: #FIELDGROUP_REFERENCE }
  ]

  @UI.lineItem: [
    { position: 10, dataAction: 'ApproveRegistration', label: 'Approve', type: #FOR_ACTION }, 
    { position: 20, dataAction: 'RejectRegistration',  label: 'Reject',  type: #FOR_ACTION },
    { position: 5, label: 'Reg. ID' },

    { position: 5, label: 'Reg. ID', qualifier: 'EventList' }
  ]
  
  @UI.identification: [
    { position: 10, dataAction: 'ApproveRegistration', label: 'Approve', type: #FOR_ACTION, qualifier: 'Default' },
    { position: 20, dataAction: 'RejectRegistration',  label: 'Reject',  type: #FOR_ACTION, qualifier: 'Default' },
    
    { position: 10, label: 'Reg. ID' }
  ]
  
  @UI.fieldGroup: [{ position: 10, qualifier: 'RegDetails' }]
  RegistrationId;

  @UI.selectionField: [{ position: 20 }] 
  @UI.lineItem: [
    { position: 20, label: 'Event' },                       
    { position: 20, label: 'Event', qualifier: 'EventList' } 
  ]
  @UI.fieldGroup: [{ position: 20, qualifier: 'RegDetails' }]
  EventTitle;

  @UI.selectionField: [{ position: 30 }] 
  @UI.lineItem: [
    { position: 30, label: 'First Name' },                        
    { position: 30, label: 'First Name', qualifier: 'EventList' } 
  ]
  @UI.identification: [{ position: 30, label: 'First Name', hidden: true }] 
  @UI.fieldGroup: [{ position: 30, qualifier: 'RegDetails', hidden: true }]
  FirstName;

  @UI.selectionField: [{ position: 40 }] 
  @UI.lineItem: [
    { position: 40, label: 'Last Name' },                        
    { position: 40, label: 'Last Name', qualifier: 'EventList' } 
  ]
  @UI.identification: [{ position: 40, label: 'Last Name', hidden: true }] 
  @UI.fieldGroup: [{ position: 40, qualifier: 'RegDetails', hidden: true }]
  LastName;

  @UI.selectionField: [{ position: 10 }] 
  @UI.lineItem: [
    { position: 50 },                        
    { position: 50, qualifier: 'EventList' } 
  ]
  @UI.fieldGroup: [{ position: 50, qualifier: 'RegDetails' }]
  Status;

  @UI.lineItem: [
    { position: 60, label: 'Remarks' },                        
    { position: 60, label: 'Remarks', qualifier: 'EventList' } 
  ]
  @UI.fieldGroup: [{ position: 60, qualifier: 'RegDetails' }]
  Remarks;

  @UI.lineItem: [{ hidden: true }] 
  @UI.fieldGroup: [{ position: 5, qualifier: 'RegDetails', label: 'Select Participant' }]
  ParticipantUuid;

  @UI.fieldGroup: [{ position: 10, qualifier: 'AdminData' }]
  CreatedBy;
  @UI.fieldGroup: [{ position: 20, qualifier: 'AdminData' }]
  CreatedAt;
  @UI.fieldGroup: [{ position: 30, qualifier: 'AdminData' }]
  LastChangedBy;
  @UI.fieldGroup: [{ position: 40, qualifier: 'AdminData' }]
  LastChangedAt;
}