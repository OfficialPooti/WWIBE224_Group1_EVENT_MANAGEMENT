projection;
strict ( 2 );
use draft;

define behavior for ZC_EVENTTPG1 alias Event
{
  use create;
  use update;
  use delete;

  field ( readonly ) StatusText;

  use association _Registrations { create; with draft; }

  // Actions für das Event
  use action OpenEvent;
  use action CloseEvent;

  // Draft Actions
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;
}

define behavior for ZC_REGISTRATIONTPG1 alias Registration
{
  use update;
  use delete;

  use association _Event { with draft; }

  // Actions für die Registrierung
  use action ApproveRegistration;
  use action RejectRegistration;
}